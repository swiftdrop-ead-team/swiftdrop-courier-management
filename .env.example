# ==============================================================================
# SwiftDrop — Parcel Delivery & Courier Management System
# Environment Configuration Template
# Copy this file to .env before starting the services locally
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=swiftdrop_identity
POSTGRES_USER=swiftdrop_user
POSTGRES_PASSWORD=swiftdrop_secure_pass_2026!
POSTGRES_PORT=5432
DB_HOST=localhost

# --- Identity Service Configuration ---
IDENTITY_SERVICE_PORT=8081
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google OAuth 2.0 Credentials ---
# In Google Cloud Console:
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Authorized Redirect URI: http://localhost:8081/login/oauth2/code/google
# 3. Paste Client ID and Secret below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Spring Cloud API Gateway ---
GATEWAY_PORT=8080
GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- React Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="SwiftDrop Courier"
