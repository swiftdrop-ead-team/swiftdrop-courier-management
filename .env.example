# ==============================================================================
# SwiftDrop — Parcel Delivery & Courier Management System
# Environment Configuration Template
# Copy this file to .env before starting the services locally
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=swiftdrop_identity
DISPATCH_DB=swiftdrop_dispatch
POSTGRES_USER=swiftdrop_user
POSTGRES_PASSWORD=swiftdrop_secure_pass_2026!
POSTGRES_PORT=5433
DB_HOST=localhost

# --- RabbitMQ Message Broker ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Identity Service Configuration (Port 8081 - Member 2) ---
IDENTITY_SERVICE_PORT=8081
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Dispatch Service Configuration (Port 8084 - Member 5) ---
DISPATCH_SERVICE_PORT=8084

# --- Google OAuth 2.0 Credentials ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Spring Cloud API Gateway (Port 8080 - Member 10) ---
GATEWAY_PORT=8080
GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- React Frontend Configuration (Port 3000 - Member 1) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="SwiftDrop Courier"
